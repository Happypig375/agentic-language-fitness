+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn single_response_session_skips_compaction_and_followup_after_limit() -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = MockServer::start().await;
+    let response_mock = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_response_created("resp-single-response"),
+            ev_completed_with_tokens("resp-single-response", /*total_tokens*/ 1_000),
+        ]),
+    )
+    .await;
+    let mut builder = test_codex().with_auth(CodexAuth::from_api_key("test-key"));
+    builder = builder.with_config(|config| {
+        config.model_auto_compact_token_limit = Some(1);
+        config
+            .features
+            .enable(Feature::NoTools)
+            .expect("no_tools feature should be configurable");
+        config
+            .features
+            .enable(Feature::SingleResponse)
+            .expect("single_response feature should be configurable");
+    });
+    let codex = builder.build(&server).await?.codex;
+    codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "hello".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&codex, |event| matches!(event, EventMsg::TurnComplete(_))).await;
+
+    assert_eq!(response_mock.requests().len(), 1);
+    let requests = server
+        .received_requests()
+        .await
+        .expect("request capture should be available");
+    assert!(
+        !requests
+            .iter()
+            .any(|request| request.url.path().ends_with("/responses/compact"))
+    );
+    Ok(())
+}
