+    let mut session = client.new_session();
+    let mut stream = session
+        .stream(
+            &Prompt::default(),
+            &test_model_info(),
+            &test_session_telemetry(),
+            None,
+            codex_protocol::config_types::ReasoningSummary::None,
+            None,
+            &metadata,
+            &InferenceTraceContext::disabled(),
+        )
+        .await?;
+    let error = loop {
+        match stream.next().await.expect("loopback policy error") {
+            Ok(ResponseEvent::RateLimits(_)) | Ok(ResponseEvent::ModelsEtag(_)) => continue,
+            Ok(event) => panic!("unexpected exposed event before policy error: {event:?}"),
+            Err(error) => break error,
+        }
+    };
+    assert_eq!(
+        error.to_string(),
+        format!("Fatal error: {}", super::NO_TOOLS_POLICY_ERROR)
+    );
+    drop(stream);
+    let requests = server
+        .received_requests()
+        .await
+        .expect("loopback request should be captured");
+    assert_eq!(requests.len(), 1);
+    let body = requests[0]
+        .body_json::<serde_json::Value>()
+        .expect("request body should be JSON");
+    assert!(body["tools"].is_null());
+    assert_eq!(body["tool_choice"], "none");
+    Ok(())
