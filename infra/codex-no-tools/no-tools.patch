+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn no_tools_feature_fails_closed_in_session_without_followup() {
+    skip_if_no_network!();
+    let fixtures = [
+        (
+            "function_call_done",
+            ev_function_call("call-no-tools", "exec_command", "{}"),
+        ),
+        (
+            "function_arguments_delta",
+            json!({"type": "response.function_call_arguments.delta", "delta": "{}"}),
+        ),
+        (
+            "function_arguments_done",
+            json!({"type": "response.function_call_arguments.done", "item_id": "fc-no-tools"}),
+        ),
+        (
+            "custom_tool_input_done",
+            json!({"type": "response.custom_tool_call_input.done", "item_id": "ctc-no-tools"}),
+        ),
+    ];
+    for (fixture_name, tool_event) in fixtures {
+        let server = MockServer::start().await;
+        let response_mock = mount_sse_once(
+            &server,
+            sse(vec![ev_response_created("resp-no-tools"), tool_event]),
+        )
+        .await;
+        let mut builder = test_codex().with_auth(CodexAuth::from_api_key("test-key"));
+        builder = builder.with_config(|config| {
+            config
+                .features
+                .enable(Feature::NoTools)
+                .expect("no_tools feature should be configurable");
+        });
+        let codex = builder
+            .build(&server)
+            .await
+            .unwrap_or_else(|error| panic!("create {fixture_name} test codex: {error}"))
+            .codex;
+        codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "hello".into(),
+                text_elements: Vec::new(),
+            }]))
+            .await
+            .expect("submit turn");
+        let event =
+            wait_for_event(&codex, |event| matches!(event, EventMsg::TurnComplete(_))).await;
+        let EventMsg::TurnComplete(completed) = event else {
+            unreachable!("wait predicate guarantees turn completion");
+        };
+        assert!(
+            completed
+                .error
+                .as_ref()
+                .is_some_and(|error| error.message.contains("no-tools policy")),
+            "{fixture_name} should terminate with policy error"
+        );
+        let request = response_mock.single_request();
+        assert_eq!(
+            response_mock.requests().len(),
+            1,
+            "{fixture_name} follow-up"
+        );
+        assert!(
+            !request
+                .body_json()
+                .to_string()
+                .contains("function_call_output")
+        );
+    }
+}
