+let private fastForward (count:int64) (w:World) =
+    let quiescent =
+        List.isEmpty w.Pending
+        && Map.isEmpty w.Requests
+        && (w.Entities |> Map.forall (fun _ entity -> entity.Kind="mover" && entity.Policy.IsNone))
+    if not quiescent then Error "nonquiescent" else
+    let minimum = bigint Int64.MinValue
+    let maximum = bigint Int64.MaxValue
+    let nextTick = bigint w.Tick + bigint count
+    let finalPosition entity = bigint entity.X + bigint entity.Velocity * bigint count
+    let positionOverflow = w.Entities |> Map.exists(fun _ entity -> let position=finalPosition entity in position<minimum || position>maximum)
+    if nextTick<minimum || nextTick>maximum || positionOverflow then Error "overflow" else
+    let entities = w.Entities |> Map.map(fun _ entity -> {entity with X=int64(finalPosition entity)})
+    Ok {w with Tick=int64 nextTick;Entities=entities}
+
 let private operation (op: JsonElement) (w: World) : Result<World,string> =
     if op.ValueKind <> JsonValueKind.Object || not (op.TryGetProperty("op") |> fst) then Error "invalid_shape"
