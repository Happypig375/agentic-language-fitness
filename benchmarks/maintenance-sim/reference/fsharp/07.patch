+                        | Ok next -> Ok(addEffect ("fast_forward:"+string count) next)
+                        | Error error -> Error error
+                    | _ -> Error "invalid_value"
             | "save" ->
                 match shape ["op";"name"] with
                 | Error e -> Error e
