@@ -382,6 +384,34 @@ let private operation (op: JsonElement) (w: World) : Result<World,string> =
                     match stringField "id" op,integerField "sequence" op,integerField "value" op with
                     | Some id,Some sequence,Some value when validId id && sequence>=0L && inRange value -> if w.Requests.TryFind id=Some sequence then Ok(addEffect (sprintf "complete:%s:%d" id value) {w with Requests=w.Requests.Remove id}) else Error "stale_completion"
