+                            | None -> Ok(addEffect ("replay:"+name) {temporary with Snapshots=w.Snapshots;Effects=w.Effects;Errors=w.Errors})
+                    | _ -> Error "invalid_value"
             | "load" ->
                 match shape ["op";"name"] with
