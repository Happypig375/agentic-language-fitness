        },
        {
          "name": "vip excludes missing null customer tier",
          "input": {
            "operation": "vipReady",
            "orders": [
              {
                "id": "missing",
                "status": "pending"
              },
              {
                "id": "null-customer",
                "status": "pending",
                "customer": null
              },
              {
                "id": "null-tier",
                "status": "pending",
                "customer": {
                  "tier": null
                }
              }
            ]
          },
          "expected": {
            "ids": []
          }
        },
        {
          "name": "vip applies ready status and ordering",
          "input": {
            "operation": "vipReady",
            "orders": [
              {
                "id": "done",
                "status": "completed",
                "priority": 99,
                "createdAt": "2026-01-01T00:00:00Z",
                "customer": {
                  "tier": "gold"
                }
              },
              {
                "id": "late",
                "status": "pending",
                "priority": 1,
                "createdAt": "2026-01-02T00:00:00Z",
                "customer": {
                  "tier": "gold"
                }
              },
              {
                "id": "early",
                "status": "pending",
                "priority": 1,
                "createdAt": "2026-01-01T00:00:00Z",
                "customer": {
                  "tier": "platinum"
                }
              }
            ]
          },
          "expected": {
            "ids": [
              "early",
              "late"
            ]
          }
        },
        {
          "name": "vip final tie uses ordinal id",
          "input": {"operation":"vipReady","orders":[{"id":"a","status":"pending","priority":4,"createdAt":"2026-01-01T00:00:00Z","customer":{"tier":"gold"}},{"id":"A","status":"pending","priority":4,"createdAt":"2026-01-01T00:00:00Z","customer":{"tier":"platinum"}},{"id":"b","status":"pending","priority":4,"createdAt":"2026-01-01T00:00:00Z","customer":{"tier":"gold"}}]},
          "expected": {"ids":["A","a","b"]}
        },
        {
          "name": "ready remains compatible without customer",
          "input": {
            "operation": "ready",
            "orders": [
              {
                "id": "old",
                "status": "pending",
                "createdAt": "2026-01-01T00:00:00Z"
              },
              {
                "id": "vip",
                "status": "pending",
                "createdAt": "2026-01-02T00:00:00Z",
                "customer": {
                  "tier": "gold"
                }
              }
            ]
          },
          "expected": {
            "ids": [
              "old",
              "vip"
            ]
          }
        },
        {
          "name": "vip ignores customer extras",
          "input": {
            "operation": "vipReady",
            "orders": [
              {
                "id": "extra",
                "status": "pending",
                "customer": {
                  "id": "x",
                  "tier": "gold",
                  "region": "APAC"
                }
              }
            ]
          },
          "expected": {
            "ids": [
              "extra"
            ]
          }
        }
      ]
    },
