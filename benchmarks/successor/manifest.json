    {
      "id": "006-transition-validation",
      "prompt": "benchmarks/successor/tasks/006-transition-validation/task.md",
      "gold": {
        "fsharp": "benchmarks/successor/gold/fsharp/006-transition-validation/Program.fs",
        "csharp": "benchmarks/successor/gold/csharp/006-transition-validation/Program.cs"
      },
      "cases": [
        {
          "name": "pending to processing",
          "input": {
            "operation": "transition",
