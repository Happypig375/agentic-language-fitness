{
  "schema_version": 1,
  "id": "successor-order-flow",
  "description": "Matched cumulative eight-task OrderFlow recalibration benchmark",
  "languages": {
    "fsharp": {
      "base": "benchmarks/successor/repos/fsharp/v0",
      "project_file": "OrderFlow.fsproj",
      "source_file": "Program.fs"
    },
    "csharp": {
      "base": "benchmarks/successor/repos/csharp/v0",
      "project_file": "OrderFlow.csproj",
      "source_file": "Program.cs"
    }
  },
  "baseline_cases": [
    {
      "name": "ready filters pending and sorts by creation time then id",
      "input": {
        "operation": "ready",
        "orders": [
          {
            "id": "b",
            "createdAt": "2026-01-02T00:00:00Z",
            "status": "pending"
          },
          {
            "id": "done",
            "createdAt": "2025-12-01T00:00:00Z",
            "status": "completed"
          },
          {
            "id": "c",
            "createdAt": "2026-01-03T00:00:00Z",
            "status": "pending"
          },
          {
            "id": "a",
            "createdAt": "2026-01-02T00:00:00Z",
            "status": "pending"
          }
        ]
      },
      "expected": {
        "ids": [
          "a",
          "b",
          "c"
        ]
      }
    },
    {
      "name": "ready accepts an empty order list",
      "input": {
        "operation": "ready",
        "orders": []
      },
      "expected": {
        "ids": []
      }
    },
    {
      "name": "null request returns the standard null-request error",
      "input": null,
      "expected": {
        "error": "Request was null"
      }
    }
  ],
  "tasks": [
    {
      "id": "001-priority",
      "prompt": "benchmarks/successor/tasks/001-priority/task.md",
      "gold": {
        "fsharp": "benchmarks/successor/gold/fsharp/001-priority/Program.fs",
        "csharp": "benchmarks/successor/gold/csharp/001-priority/Program.cs"
      },
      "cases": [
        {
          "name": "ready sorts priority descending before creation time and id",
          "input": {
            "operation": "ready",
            "orders": [
              {
                "id": "low",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending",
                "priority": 1
              },
              {
                "id": "z",
                "createdAt": "2026-01-03T00:00:00Z",
                "status": "pending",
                "priority": 5
              },
              {
                "id": "a",
                "createdAt": "2026-01-03T00:00:00Z",
                "status": "pending",
                "priority": 5
              },
              {
                "id": "early",
                "createdAt": "2026-01-02T00:00:00Z",
                "status": "pending",
                "priority": 5
              }
            ]
          },
          "expected": {
            "ids": [
              "early",
              "a",
              "z",
              "low"
            ]
          }
        },
        {
          "name": "missing priority defaults to zero",
          "input": {
            "operation": "ready",
            "orders": [
              {
                "id": "implicit",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending"
              },
              {
                "id": "negative",
                "createdAt": "2025-01-01T00:00:00Z",
                "status": "pending",
                "priority": -1
              }
            ]
          },
          "expected": {
            "ids": [
              "implicit",
              "negative"
            ]
          }
        }
      ]
    },
    {
      "id": "002-overdue",
      "prompt": "benchmarks/successor/tasks/002-overdue/task.md",
      "gold": {
        "fsharp": "benchmarks/successor/gold/fsharp/002-overdue/Program.fs",
        "csharp": "benchmarks/successor/gold/csharp/002-overdue/Program.cs"
      },
      "cases": [
        {
          "name": "overdue filters status and due date and applies the specified ordering",
          "input": {
            "operation": "overdue",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "late-low",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending",
                "priority": 1,
                "dueAt": "2026-02-01T00:00:00Z"
              },
              {
                "id": "late-high",
                "createdAt": "2026-01-05T00:00:00Z",
                "status": "processing",
                "priority": 8,
                "dueAt": "2026-02-01T00:00:00Z"
              },
              {
                "id": "older",
                "createdAt": "2026-01-08T00:00:00Z",
                "status": "pending",
                "priority": 0,
                "dueAt": "2026-01-20T00:00:00Z"
              },
              {
                "id": "complete",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "completed",
                "priority": 99,
                "dueAt": "2026-01-01T00:00:00Z"
              },
              {
                "id": "future",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending",
                "priority": 99,
                "dueAt": "2026-03-01T00:00:00Z"
              },
              {
                "id": "undated",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending",
                "priority": 99
              }
            ]
          },
          "expected": {
            "ids": [
              "older",
              "late-high",
              "late-low"
            ]
          }
        },
        {
          "name": "due exactly at asOf is not overdue",
          "input": {
            "operation": "overdue",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "equal",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending",
                "dueAt": "2026-02-10T00:00:00Z"
              },
              {
                "id": "before",
                "createdAt": "2026-01-01T00:00:00Z",
                "status": "pending",
                "dueAt": "2026-02-09T23:59:59Z"
              }
            ]
          },
          "expected": {
            "ids": [
              "before"
            ]
          }
        }
      ]
    },
    {
      "id": "003-at-risk-window",
      "prompt": "benchmarks/successor/tasks/003-at-risk-window/task.md",
      "gold": {
        "fsharp": "benchmarks/successor/gold/fsharp/003-at-risk-window/Program.fs",
        "csharp": "benchmarks/successor/gold/csharp/003-at-risk-window/Program.cs"
      },
      "cases": [
        {
          "name": "atRisk lower inclusive",
          "input": {
            "operation": "atRisk",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "start",
                "status": "pending",
                "dueAt": "2026-02-10T00:00:00Z"
              },
              {
                "id": "inside",
                "status": "processing",
                "dueAt": "2026-02-10T23:59:59Z"
              }
            ]
          },
          "expected": {
            "ids": [
              "start",
              "inside"
            ]
          }
        },
        {
          "name": "atRisk upper exclusive",
          "input": {
            "operation": "atRisk",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "end",
                "status": "pending",
                "dueAt": "2026-02-11T00:00:00Z"
              },
              {
                "id": "after",
                "status": "pending",
                "dueAt": "2026-02-11T00:00:01Z"
              },
              {
                "id": "before",
                "status": "pending",
                "dueAt": "2026-02-09T23:59:59Z"
              }
            ]
          },
          "expected": {
            "ids": []
          }
        },
        {
          "name": "atRisk one second inside lower boundary",
          "input": {"operation":"atRisk","asOf":"2026-02-10T00:00:00Z","orders":[{"id":"inside","status":"pending","dueAt":"2026-02-10T00:00:01Z"},{"id":"before","status":"pending","dueAt":"2026-02-09T23:59:59Z"}]},
          "expected": {"ids":["inside"]}
        },
        {
          "name": "atRisk compares equivalent offsets",
          "input": {
            "operation": "atRisk",
            "asOf": "2026-02-10T00:00:00+02:00",
            "orders": [
              {
                "id": "same",
                "status": "PENDING",
                "dueAt": "2026-02-10T00:00:00+00:00"
              },
              {
                "id": "inside",
                "status": "processing",
                "dueAt": "2026-02-10T23:00:00+02:00"
              }
            ]
          },
          "expected": {
            "ids": [
              "same",
              "inside"
            ]
          }
        },
        {
          "name": "atRisk due priority and ordinal id ordering",
          "input": {
            "operation": "atRisk",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "z",
                "status": "pending",
                "dueAt": "2026-02-10T01:00:00Z",
                "priority": -1
              },
              {
                "id": "A",
                "status": "pending",
                "dueAt": "2026-02-10T01:00:00Z",
                "priority": 2
              },
              {
                "id": "a",
                "status": "pending",
                "dueAt": "2026-02-10T01:00:00Z",
                "priority": 2
              },
              {
                "id": "high",
                "status": "pending",
                "dueAt": "2026-02-10T01:00:00Z",
                "priority": 3
              },
              {
                "id": "missing",
                "status": "pending",
                "dueAt": "2026-02-10T02:00:00Z"
              }
            ]
          },
          "expected": {
            "ids": [
              "high",
              "A",
              "a",
              "z",
              "missing"
            ]
          }
        },
        {
          "name": "atRisk excludes statuses and undated",
          "input": {
            "operation": "atRisk",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "completed",
                "status": "completed",
                "dueAt": "2026-02-10T01:00:00Z"
              },
              {
                "id": "cancelled",
                "status": "CANCELLED",
                "dueAt": "2026-02-10T01:00:00Z"
              },
              {
                "id": "unknown",
                "status": "mystery",
                "dueAt": "2026-02-10T01:00:00Z"
              },
              {
                "id": "undated",
                "status": "pending"
              }
            ]
          },
          "expected": {
            "ids": []
          }
        },
        {
          "name": "atRisk excludes null dueAt",
          "input": {
            "operation": "atRisk",
            "asOf": "2026-02-10T00:00:00Z",
            "orders": [
              {
                "id": "null-due",
                "status": "pending",
                "dueAt": null
              },
              {
                "id": "valid",
                "status": "pending",
                "dueAt": "2026-02-10T01:00:00Z"
              }
            ]
          },
          "expected": {
            "ids": [
              "valid"
            ]
          }
        },
        {
          "name": "atRisk missing asOf",
          "input": {
            "operation": "atRisk",
            "orders": []
          },
          "expected": {
            "error": "asOf is required for atRisk"
          }
        },
        {
          "name": "atRisk null asOf",
          "input": {
            "operation": "atRisk",
            "asOf": null,
            "orders": []
          },
          "expected": {
            "error": "asOf is required for atRisk"
          }
        },
        {
          "name": "unknown operation exact error",
          "input": {
            "operation": "mystery",
            "orders": []
          },
          "expected": {
            "error": "Unknown operation: mystery"
          }
        }
      ]
    },
    {
      "id": "004-vip-ready",
      "prompt": "benchmarks/successor/tasks/004-vip-ready/task.md",
      "gold": {
        "fsharp": "benchmarks/successor/gold/fsharp/004-vip-ready/Program.fs",
        "csharp": "benchmarks/successor/gold/csharp/004-vip-ready/Program.cs"
      },
      "cases": [
        {
          "name": "vip gold platinum mixed case",
          "input": {
            "operation": "vipReady",
            "orders": [
              {
                "id": "gold",
